{
  "name": "port0-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Static web app for the port0.sh constant-product AMM: browse pools, swap, deposit, withdraw, create pools.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@getpara/web-sdk": "^3.18.0",
    "@miden-sdk/miden-sdk": "0.17.1",
    "@miden-sdk/miden-wallet-adapter-base": "^0.17.0",
    "@miden-sdk/miden-wallet-adapter-miden": "^0.17.0",
    "@miden-sdk/para": "^0.17.0",
    "lightweight-charts": "^5.2.1",
    "port0-sdk": "file:../port0_sdk"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "oxlint": "^1.69.0",
    "typescript": "~5.9.3",
    "vite": "^8.1.0",
    "vitest": "^3.0.0"
  }
}
