# Miden node RPC used for on-chain reads and note building.
# Testnet is the only network this app targets.
VITE_MIDEN_RPC_URL=https://rpc.testnet.miden.io

# Faucet of the chain's fee asset (0.17 protocol configuration). This is both
# the feeFaucetId required by MidenClient.create and the network note-fee
# faucet of every pool this app creates. Defaults to the 0.17 testnet value.
VITE_CHAIN_FEE_FAUCET_ID=0x4cbdcaffe75f0a317482224dae6436

# Platform fee recipient. Every pool created through the app sends its
# protocol fee (1/6 of the LP fee) to this account. Hex or bech32.
# Displayed on the create page; users cannot change it.
VITE_PROTOCOL_FEE_RECIPIENT=

# Para wallet (getpara.com). Empty apiKey keeps the Para option disabled in
# the wallet picker. Production deployments need a production key and
# VITE_PARA_ENVIRONMENT=PRODUCTION.
VITE_PARA_API_KEY=
VITE_PARA_ENVIRONMENT=BETA

# On-chain pool registry account. When set, pool creation emits a register
# note after the admin configuration. Empty disables registration.
VITE_REGISTRY_ID=

# Register note consumption fee, in the registry's fee asset (the chain fee
# asset). Must match the registry's note fee schedule. Decimal string.
VITE_REGISTRY_REGISTER_FEE=0

# Indexer base URL. When set, pool state is read from the indexer in one
# request instead of one account fetch per pool. Empty keeps per-pool reads.
VITE_INDEXER_URL=

# Branding. MidenXYK is the library; a deployment is a platform with its own
# name, mark, and artwork.
#
# VITE_BRAND_NAME      wordmark and page-title name
# VITE_BRAND_LOGO_TEXT single-line text mark, used when no image is given
# VITE_BRAND_LOGO_IMAGE logo image path or URL, takes precedence over the text
# VITE_BRAND_SLOGAN    one line under the name on the home page; empty hides it
VITE_BRAND_NAME=
VITE_BRAND_LOGO_TEXT=
VITE_BRAND_LOGO_IMAGE=
