# Miden node RPC used for on-chain reads and note building.
# Testnet is the only network this app targets.
VITE_MIDEN_RPC_URL=https://rpc.testnet.miden.io

# Faucet of the chain's fee asset (0.17 protocol configuration). This is both
# the feeFaucetId required by MidenClient.create and the network note-fee
# faucet of every pool this app creates. Defaults to the 0.17 testnet value.
VITE_CHAIN_FEE_FAUCET_ID=0x4cbdcaffe75f0a317482224dae6436

# Platform fee recipient. Pool creation is gated on this value. The pools pay
# their protocol fee to the registry's protocol_fee_to slot; this value is the
# deployment's expected recipient and is shown on the create page. Hex or
# bech32. The create flow reads the fee rate and the destination from the
# registry.
VITE_PROTOCOL_FEE_RECIPIENT=

# Para wallet (getpara.com). Empty apiKey keeps the Para option disabled in
# the wallet picker. Production deployments need a production key and
# VITE_PARA_ENVIRONMENT=PRODUCTION.
VITE_PARA_API_KEY=
VITE_PARA_ENVIRONMENT=BETA

# On-chain pool registry account. When set, pool creation emits a register
# note after the pool is deployed. Empty disables registration.
VITE_REGISTRY_ID=

# Register note consumption fee, in the registry's fee asset (the chain fee
# asset). Must match the registry's note fee schedule. Decimal string.
VITE_REGISTRY_REGISTER_FEE=210

# Indexer base URL. When set, pool state is read from the indexer in one
# request instead of one account fetch per pool. Empty keeps per-pool reads.
VITE_INDEXER_URL=

# Branding. The name and slogan come from here; the drawings are files.
#
# VITE_BRAND_NAME      wordmark and page-title name
# VITE_BRAND_LOGO_TEXT short mark beside the header logo; empty uses the name
# VITE_BRAND_SLOGAN    one line under the name on the home page; empty hides it
#
# The drawings are src/assets/branding/hero.html on the home page and
# src/assets/branding/logo.html in the header of the other pages. Edit either by
# hand; nothing in the application reassembles a drawing.
VITE_BRAND_NAME=port0.sh
VITE_BRAND_LOGO_TEXT=
VITE_BRAND_SLOGAN="The free port of Miden"

# Site origin, absolute, no trailing slash. Canonical, og:url, and the unfurl
# image URLs are built from it, and unfurl scrapers do not follow relative ones.
# The apex is canonical; www belongs in a redirect at the host.
VITE_SITE_URL=https://port0.sh

# Brand metadata for unfurls and the web app manifest.
#
# VITE_BRAND_MARK_TEXT   text form of the mark, used in page titles
# VITE_BRAND_TAGLINE     unfurl title, and the alt text of the unfurl image
# VITE_BRAND_DESCRIPTION unfurl and manifest description
# VITE_BRAND_X_HANDLE    X account, for twitter:site
VITE_BRAND_MARK_TEXT=[p0]
VITE_BRAND_TAGLINE="port0.sh, the free port on Miden"
VITE_BRAND_DESCRIPTION="port0 is an open source exchange built on Miden. A safe harbor for any token."
VITE_BRAND_X_HANDLE=@port0_sh

# Block explorer, without a trailing slash. Account ids are appended to it.
VITE_EXPLORER_URL=https://testnet.midenscan.com/account
