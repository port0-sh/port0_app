# testnet | devnet | localnet | mainnet. Unknown values fail the build.
VITE_NETWORK=testnet

# Optional per-network overrides; unset uses the network's default.
# VITE_MIDEN_RPC_URL=https://rpc.testnet.miden.io
# VITE_CHAIN_FEE_FAUCET_ID=0x4cbdcaffe75f0a317482224dae6436
# VITE_PROVER_URL=testnet
# VITE_NOTE_TRANSPORT_URL=testnet
# VITE_EXPLORER_URL=https://testnet.midenscan.com/account

# Registry account id, hex. Empty creates pools without registering them.
VITE_REGISTRY_ID=

# Indexer base URL. Empty disables the pool list and the pool page.
VITE_INDEXER_URL=

# Para wallet. Empty key disables the option. BETA | PRODUCTION.
VITE_PARA_API_KEY=
VITE_PARA_ENVIRONMENT=BETA

# Site origin: absolute, no trailing slash.
VITE_SITE_URL=https://port0.sh

# Brand and unfurl metadata.
VITE_BRAND_NAME=port0.sh
VITE_BRAND_LOGO_TEXT=
VITE_BRAND_SLOGAN="The free port of Miden"
VITE_BRAND_MARK_TEXT=[p0]
VITE_BRAND_TAGLINE="port0.sh, the free port on Miden"
VITE_BRAND_DESCRIPTION="port0 is an open source exchange built on Miden. A safe harbor for any token."
VITE_BRAND_X_HANDLE=@port0_sh
