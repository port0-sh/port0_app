# Neutral branding: the open-source face of the project, used to check that a
# deployment has not leaked its own branding into the shared defaults. Loaded by
# `npm run dev:neutral` and `npm run build:neutral` (Vite mode `neutral`), which
# override the same keys in .env. Every other key still comes from .env.
#
# The empty override keeps `src/assets/branding/hero.local.html` and its
# siblings out of the picture, so the shipped hero.html and logo.html are used.

VITE_BRAND_NAME=MidenXYK
VITE_BRAND_LOGO_TEXT=MidenXYK
VITE_BRAND_SLOGAN=An open AMM for Miden
VITE_BRAND_OVERRIDE=
